{
  "name": "obsidian-quickview",
  "version": "1.0.0",
  "description": "Blazing fast, lightweight viewer and editor for Obsidian vaults",
  "scripts": {
    "build": "node scripts/build.js",
    "build:cm6": "node scripts/build.js",
    "test:markdown": "node tests/test_render_markdown.js",
    "test:editor": "node tests/test_editor_architecture.js",
    "test:live-editor": "node tests/test_live_editor.js",
    "test:arch": "python3 scripts/check_architecture.py",
    "test": "node tests/test_render_markdown.js && node tests/test_editor_architecture.js && node tests/test_live_editor.js && python3 -m unittest discover tests && python3 scripts/check_architecture.py"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.2",
    "katex": "^0.16.47",
    "marked": "^12.0.2"
  }
}
